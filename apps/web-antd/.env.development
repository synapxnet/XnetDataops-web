# 端口号
VITE_PORT=5888

VITE_BASE=/

# USR模块接口地址 (用户认证)
VITE_GLOB_API_URL=/usr

# DSM模块接口地址 (数据源管理)
VITE_DSM_API_URL=/dsm

# DIM模块接口地址 (数据集成)
VITE_DIM_API_URL=/dim

# DDV模块接口地址 (数据开发)
VITE_DDV_API_URL=/ddv

# TSK模块接口地址 (任务调度)
VITE_TSK_API_URL=/tsk

# DQM模块接口地址 (数据质量)
VITE_DQM_API_URL=/dqm

# DGV模块接口地址 (数据治理)
VITE_DGV_API_URL=/dgv

# DAS模块接口地址 (数据资产)
VITE_DAS_API_URL=/das

# DAU模块接口地址 (数据审计)
VITE_DAU_API_URL=/dau

# DOB模块接口地址 (数据可观测性)
VITE_DOB_API_URL=/dob

# DAP模块接口地址 (数据API)
VITE_DAP_API_URL=/dap

# DMS模块接口地址 (数据脱敏)
VITE_DMS_API_URL=/dms

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=true

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
