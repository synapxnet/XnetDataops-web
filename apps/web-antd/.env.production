VITE_BASE=/

# USR模块接口地址 (用户认证)
VITE_GLOB_API_URL=/api

# DSM模块接口地址 (数据源管理)
VITE_DSM_API_URL=/dsm

# DIM模块接口地址 (数据集成)
VITE_DIM_API_URL=/dim

# DDV模块接口地址 (数据开发)
VITE_DDV_API_URL=/ddv

# TSK模块接口地址 (任务调度)
VITE_TSK_API_URL=/tsk

# DQM模块接口地址 (数据质量)
VITE_DQM_API_URL=/dqm

# DGV模块接口地址 (数据治理)
VITE_DGV_API_URL=/dgv

# DAS模块接口地址 (数据资产)
VITE_DAS_API_URL=/das

# DAP模块接口地址 (数据API)
VITE_DAP_API_URL=/dap

# DMS模块接口地址 (数据脱敏)
VITE_DMS_API_URL=/dms

# DOB模块接口地址 (数据可观测性)
VITE_DOB_API_URL=/dob

# DAU模块接口地址 (数据审计)
VITE_DAU_API_URL=/dau

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
