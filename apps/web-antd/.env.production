# TSK模块接口地址 (任务调度)
VITE_TSK_API_URL=http://192.168.1.156:9284/api

# DQM模块接口地址 (数据质量)
VITE_DQM_API_URL=http://192.168.1.156:9285/api

# DGV模块接口地址 (数据治理)
